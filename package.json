{
  "name": "deckforge-input-studio",
  "version": "0.1.0",
  "description": "Advanced input device configuration and mapping studio for Steam Deck via Decky Loader",
  "type": "module",
  "scripts": {
    "build": "rollup -c && bun build src/web-entry.tsx --outdir static/dist",
    "build:plugin": "rollup -c",
    "build:web": "bun build src/web-entry.tsx --outdir static/dist",
    "watch": "rollup -c --watch"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/deckforge/input-studio"
  },
  "license": "GPL-2.0-or-later",
  "dependencies": {
    "@decky/ui": "^4.0.0",
    "@decky/api": "^1.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@decky/rollup": "^1.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.5.0",
    "rollup": "^4.18.0"
  },
  "peerDependencies": {
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  }
}
